# Copie este arquivo para .env e ajuste os valores.
# cp .env .env.example  (não commitar o .env real!)

# URL do Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modelo padrão do Ollama (precisa estar baixado: ollama pull llama3)
DEFAULT_OLLAMA_MODEL=llama3

# (Opcional) Chaves carregadas no start do backend. Alternativamente,
# configure-as pela UI do aplicativo (armazenamento em memória da sessão).
# OPENAI_API_KEY=sk-sua-chave-openai
# GOOGLE_API_KEY=sua-chave-google

# Logar prompts completos em DEBUG (padrão: false). Nunca habilitar em produção.
# LOG_PROMPTS=true
